# Headless fallback only. The normal path is the in-app Settings panel (the gear,
# or Cmd-,), which stores the provider and key in the SQLite file below. This is
# consulted only when nothing has been saved there. Leave unset to run the board
# without AI proposals — that is a supported configuration.
ANTHROPIC_API_KEY=

# Where the SQLite board database lives.
SMARTI_DB_PATH=./data/smarti.db
