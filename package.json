{
  "name": "smarti-board",
  "version": "3.0.0",
  "description": "A web idea board with a built-in AI collaborator that proposes gap-fills and connections as you work.",
  "author": "KGthePM",
  "repository": {
    "type": "git",
    "url": "https://github.com/KGthePM/SmartiBoard.git"
  },
  "homepage": "https://smartiboard.netlify.app/",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.js",
    "dev": "next dev -H ${SMARTI_HOST:-127.0.0.1}",
    "build": "next build",
    "start": "next start -H ${SMARTI_HOST:-127.0.0.1}",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "better-sqlite3": "^12.2.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
