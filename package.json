{
  "name": "smarti-board",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.js",
    "dev": "node scripts/run-next.js dev",
    "build": "next build",
    "start": "node scripts/run-next.js start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "desktop:install": "npm install --prefix desktop",
    "desktop:dist": "npm run dist --prefix desktop",
    "desktop:dir": "npm run dir --prefix desktop",
    "desktop:notices": "node scripts/generate-third-party-notices.js",
    "version:check": "node scripts/check-release.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "better-sqlite3": "^12.2.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
