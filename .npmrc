# npm checks `engines` before it reifies anything, so an unsupported Node stops the
# install with zero side effects. This has to be a config flag rather than the
# friendlier scripts/check-node.js message: npm runs the root `preinstall` script
# *after* building the dependency tree, by which point better-sqlite3 has already
# tried (and on a stock Debian/Ubuntu box, failed) to compile itself via node-gyp.
# The terse EBADENGINE error is worth it to never reach that.
engine-strict=true
