# Mirrors the root app's rule: Electron 42's install script (and its @electron/get,
# now ESM-only) needs Node 22+. Without engine-strict, npm runs that script under
# whatever node is on PATH and it dies with ERR_REQUIRE_ESM on Node 18. The root
# .npmrc does not reach this directory — desktop is a separate package, so it needs
# its own copy of the gate.
engine-strict=true
