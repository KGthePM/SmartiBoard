{
  "name": "smarti-board-desktop",
  "version": "3.0.0",
  "description": "Desktop shell for Smarti Board",
  "author": "KGthePM",
  "license": "AGPL-3.0-only",
  "homepage": "https://smartiboard.netlify.app/",
  "private": true,
  "main": "main.js",
  "scripts": {
    "stage": "node stage.js",
    "dev": "node stage.js && electron .",
    "dist": "node stage.js && electron-builder --publish never",
    "dist:win": "node stage.js --platform=win32 && electron-builder --publish never --win",
    "dist:linux": "node stage.js --platform=linux && electron-builder --publish never --linux",
    "dist:mac": "node stage.js --platform=darwin --arch=arm64 && electron-builder --publish never --mac --arm64",
    "dist:mac:notarized": "node stage.js --platform=darwin --arch=arm64 && electron-builder --publish never --mac --arm64 --config.mac.notarize=true",
    "dist:mac:intel": "node stage.js --platform=darwin --arch=x64 && electron-builder --publish never --mac --x64"
  },
  "devDependencies": {
    "electron": "42.11.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.smartiboard.desktop",
    "productName": "Smarti Board",
    "copyright": "Copyright \u00a9 2026 KGthePM. AGPL-3.0-only.",
    "publish": null,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "loading.html",
      "app/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "app/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Smarti Board",
      "license": "../LICENSE",
      "artifactName": "SmartiBoard-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "SmartiBoard-${version}-win-${arch}-portable.exe"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "synopsis": "A web idea board with a built-in AI collaborator",
      "artifactName": "SmartiBoard-${version}-linux-${arch}.${ext}",
      "maintainer": "KGthePM <kgomez2k19@gmail.com>"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false
    },
    "dmg": {
      "artifactName": "SmartiBoard-${version}-mac-${arch}.${ext}"
    },
    "afterPack": "verify-arch.js"
  },
  "allowScripts": {
    "electron@42.11.0": true
  }
}
